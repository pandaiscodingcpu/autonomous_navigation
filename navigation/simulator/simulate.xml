<mujoco>
  <!-- Set global air density (1.225 kg/m^3) so MuJoCo calculates basic drag -->
  <option gravity="0 0 -9.81" density="1.225" viscosity="1.8e-5"/> 
  
  <worldbody>
    <!-- The Canopy -->
    <body name="canopy" pos="0 0 1000">
      <freejoint/> 
      <!-- fluidshape enables built-in aerodynamic drag based on the geometry -->
      <geom name="canopy_geom" type="ellipsoid" size="1.5 0.5 0.1" mass="0.2" fluidshape="ellipsoid"/>
      
      <!-- The CanSat Payload -->
      <body name="payload" pos="0 0 -1.5">
        <!-- Ball joint allows pendulum swinging; damping prevents infinite oscillation -->
        <joint name="suspension_lines" type="ball" damping="0.5"/> 
        <geom name="cansat_geom" type="cylinder" size="0.05 0.15" mass="1.0"/>
      </body>
    </body>
  </worldbody>
</mujoco>